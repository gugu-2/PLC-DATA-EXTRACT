# ==============================================================================
# INDUSTRIAL AI SYNTHETIC DATASET ENGINE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# LLM Backend Provider: 'gemini' | 'openai' | 'anthropic' | 'groq' | 'openrouter' | 'ollama' | 'mock'
DEFAULT_BACKEND=gemini

# Default Model Selection:
# Gemini: gemini-2.5-pro, gemini-2.0-flash, gemini-1.5-pro
# OpenAI: gpt-4o, o1, o3-mini
# Anthropic: claude-3-5-sonnet-20241022
# Groq: deepseek-r1-distill-llama-70b, llama-3.3-70b-versatile
# Ollama: qwen2.5-coder:14b, deepseek-coder-v2:16b
DEFAULT_MODEL=gemini-2.5-pro

# API Keys (Set the one matching your selected backend)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Ollama / vLLM / Local Endpoint Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Swarm Execution Settings
CONCURRENT_AGENTS=8
TOKEN_CONSUMPTION_LEVEL=extreme
MIN_CODE_CHARACTERS=3500
TARGET_CODE_CHARACTERS=65000
AUTO_REPAIR_ON_SYNTAX_ERROR=true
INFINITE_LOOP=true
SAVE_DIRECTORY=data/raw
EXPORTS_DIRECTORY=data/exports
LOG_DIRECTORY=data/logs
